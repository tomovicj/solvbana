# Primary RPC endpoint. Public nodes retain roughly two days of history, which
# is shorter than most of the failures worth debugging.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Archive endpoint used when a signature falls outside the primary
# node's retention window. Without one, older signatures resolve to `unknown`.
# SOLANA_ARCHIVE_RPC_URL=

# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# NODE_ENV=development

# Optional. Verified-build registry, used to map a deployed binary's hash to a
# repository and commit. Set to an empty string to disable the lookup — the
# diagnosis then says so rather than quietly omitting source provenance.
# SOLVBANA_VERIFY_REGISTRY_URL=https://verify.osec.io

# Optional. Directory holding IDLs and program binaries uploaded through
# POST /artifacts. Roughly 94% of the programs that fail on mainnet publish
# neither an on-chain IDL nor a verified build, so for those this is the only
# route to an error name. Unset, uploads are refused rather than discarded.
# SOLVBANA_ARTIFACT_DIR=./artifacts

# Optional. Largest accepted request body, in bytes. The default (32MB) is sized
# for program uploads: a compiled .so reaches about 1.5MB and base64 adds a
# third again, well past Fastify's 1MB default.
# SOLVBANA_MAX_BODY_BYTES=33554432
