# Primary RPC endpoint. Public nodes retain roughly two days of history, which
# is shorter than most of the failures worth debugging.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Archive endpoint used when a signature falls outside the primary
# node's retention window. Without one, older signatures resolve to `unknown`.
# SOLANA_ARCHIVE_RPC_URL=

# Authentication. The server refuses to start unless exactly one of these two
# is set, whatever NODE_ENV says.
#
# API keys as comma-separated `tenant:sha256hex` pairs. The hash is the SHA-256
# of the secret, so the server never holds the secret itself:
#   printf '%s' "$SECRET" | sha256sum | cut -d' ' -f1
# A tenant name matches ^[a-z0-9][a-z0-9_-]{0,63}$ and may appear once. Each
# tenant sees and is diagnosed against only its own uploaded artifacts.
# SOLVBANA_API_KEYS=alice:<64 hex characters>
#
# For local development only: run with no keys, as the single tenant `local`.
SOLVBANA_ALLOW_UNAUTHENTICATED=true

# Optional. Requests per tenant per minute, and per client address for requests
# that fail authentication. Each diagnosis spends paid RPC calls.
# SOLVBANA_RATE_LIMIT_PER_MINUTE=60

# Optional. Read the client address from X-Forwarded-For. Enable only behind a
# proxy that overwrites that header, or a client can pick its own rate-limit
# bucket.
# SOLVBANA_TRUST_PROXY=false

# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# NODE_ENV=development

# Optional. Verified-build registry, used to map a deployed binary's hash to a
# repository and commit. Set to an empty string to disable the lookup — the
# diagnosis then says so rather than quietly omitting source provenance.
# SOLVBANA_VERIFY_REGISTRY_URL=https://verify.osec.io

# Optional. Directory holding IDLs, program binaries and Rust source uploaded through
# POST /artifacts. Roughly 94% of the programs that fail on mainnet publish
# neither an on-chain IDL nor a verified build, so for those this is the only
# route to an error name. Filed per tenant, under tenants/<tenant>/. Unset,
# uploads are refused rather than discarded.
# SOLVBANA_ARTIFACT_DIR=./artifacts

# Optional. Largest accepted request body, in bytes. The default (32MB) is sized
# for program uploads: a compiled .so reaches about 1.5MB and base64 adds a
# third again, well past Fastify's 1MB default.
# SOLVBANA_MAX_BODY_BYTES=33554432
